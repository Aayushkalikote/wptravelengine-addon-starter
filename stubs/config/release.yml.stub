name: Create Release
on:
  push:
    tags:
      - "v*.*.*"
jobs:
  tag:
    name: New tag
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Detect if tag is from next
        id: from_next
        run: |
          git fetch origin '+refs/heads/*:refs/remotes/origin/*' --quiet
          if git branch -r --contains HEAD | grep -qE '^[* ]*origin/next$'; then
            echo "result=true" >> "$GITHUB_OUTPUT"
            echo "branch=next" >> "$GITHUB_OUTPUT"
          else
            echo "result=false" >> "$GITHUB_OUTPUT"
            branch=$(git branch -r --contains HEAD | grep -vE 'origin/(HEAD|next)( ->.*)?$' | head -n1 | sed 's#^[* ]*origin/##')
            echo "branch=${branch}" >> "$GITHUB_OUTPUT"
          fi

      - name: Checkout shared actions
        uses: actions/checkout@v4
        with:
          repository: Codewing-Solutions/wptravelengine
          ref: main
          token: ${{ secrets.ACCESS_TOKEN }}
          path: _wte_actions
          sparse-checkout: |
            .github/actions
            .github/scripts
          sparse-checkout-cone-mode: false

      - name: Copy shared actions to workspace
        run: |
          mkdir -p .github/actions .github/scripts
          cp -r _wte_actions/.github/actions/. .github/actions/
          cp -r _wte_actions/.github/scripts/. .github/scripts/

      # Step to set up PHP (if using Composer)
      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '7.4' # Choose your PHP version
          extensions: mbstring, dom
          tools: composer
{{COMPOSER_AUTH}}
      # Step to install wp-cli
      - name: Install wp-cli
        run: |
          curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar
          chmod +x wp-cli.phar
          sudo mv wp-cli.phar /usr/local/bin/wp

      # Step to set up Node.js (if using NPM for assets)
      - name: Setup Node
        uses: actions/setup-node@v3
        with:
          node-version: '20'  # Specify your Node.js version

      # Must run before stamp-version: sync-metadata writes package.json's version, which stamp-version reads.
      - name: Prepare addon (sync metadata + readme changelog)
        uses: ./.github/actions/prepare-addon
        with:
          target-branch: ${{ steps.from_next.outputs.branch }}

      - name: Stamp @since/@deprecated next
        if: steps.from_next.outputs.result == 'true'
        uses: ./.github/actions/stamp-version
        with:
          commit-changes: ${{ contains(github.ref, '-rc') }}
          target-branch: ${{ steps.from_next.outputs.branch }}

      - name: Fix PHP formatting
        if: steps.from_next.outputs.result == 'true'
        uses: ./.github/actions/fix-php

      # Optional: If your plugin is using composer dependencies, we want to include them
      # WITHOUT the dev dependencies.
      - name: Build
        run: |
          yarn install
          yarn bundle

      - name: Read package.json
        id: package_json  # Set an ID so we can reference the outputs later
        run: |
          name=$(jq -r .name < package.json)
          version=$(jq -r .version < package.json)
          echo "PACKAGE_NAME=$name" >> $GITHUB_ENV
          echo "PACKAGE_VERSION=$version" >> $GITHUB_ENV
        shell: bash

      - name: Create zip # artifacts to upload to release.
        id: create_zip
        run: |
          cd bundle
          zip -r ${{ env.PACKAGE_NAME }}-${{ env.PACKAGE_VERSION }}.zip ${{ env.PACKAGE_NAME }}
          echo "ZIP_PATH=bundle/${{ env.PACKAGE_NAME }}-${{ env.PACKAGE_VERSION }}.zip" >> $GITHUB_ENV

      - name: Determine if pre-release
        id: pre_release_check
        run: |
          if [[ "${GITHUB_REF##*/}" == *"-alpha"* || "${GITHUB_REF##*/}" == *"-beta"* || "${GITHUB_REF##*/}" == *"-rc"* ]]; then
            echo "is_prerelease=true" >> $GITHUB_ENV
          else
            echo "is_prerelease=false" >> $GITHUB_ENV
          fi

      - name: Create GitHub release
        id: create_release
        uses: softprops/action-gh-release@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          files: ${{ env.ZIP_PATH }}
          body: |
            Release ${{ env.PACKAGE_VERSION }}
          prerelease: ${{ env.is_prerelease == 'true' }}
          generate_release_notes: true

      # Must run after the release step, so the zip is attached before dispatching.
      - name: Maybe Deploy Release
        env:
          GH_TOKEN: ${{ secrets.ACCESS_TOKEN }}
          ADDON_REPO: ${{ github.repository }}
          TAG: ${{ github.ref_name }}
        run: |
          set -uo pipefail

          # shellcheck source=/dev/null
          source .github/scripts/deploy-addon/dispatch.sh

          wpte_maybe_dispatch \
            "$ADDON_REPO" "$TAG" "${PACKAGE_VERSION:-}" "${is_prerelease:-false}" || exit 1
